@model tl2_tp8_2025_michdeaver.ViewModels.PresupuestoViewModel

@{
    ViewData["Title"] = "Eliminar Presupuesto";
}

<h2>@ViewData["Title"]</h2>

<h4>¿Estás seguro que deseas eliminar este presupuesto?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.IdPresupuesto)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.IdPresupuesto)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.NombreDestinatario)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.NombreDestinatario)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.FechaCreacion)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.FechaCreacion)
    </dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    
    <!-- ID oculto necesario para el POST -->
    <input type="hidden" asp-for="IdPresupuesto" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>